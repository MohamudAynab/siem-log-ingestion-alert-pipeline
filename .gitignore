# ============================
# Project-specific: SIEM lab
# ============================

# VirtualBox virtual-machine files
*.vdi
*.vmdk
*.vbox
*.vbox-prev
*.ova
*.ovf

# Sensitive configuration and credentials
.env.local
*.pem
*.key
*.pfx
*.p12
credentials.json
secrets.json
*_credentials*
config/local.*

# Security logs and network captures
*.evtx
*.pcap
*.pcapng
*.har

# Operating-system files
.DS_Store
Thumbs.db


# Environment Variables & Secrets
.env
.env.local
config/local.*

# Database Files (SQLite)
*.db
*.sqlite
*.sqlite3

# Python Caches
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/

# Raw log drop-off from VM shared folders (populated at runtime, not committed)
ingestion/incoming/*
!ingestion/incoming/*/
!ingestion/incoming/*/.gitkeep

# Per-machine ingestion collector state (record IDs / file offsets)
ingestion/.state/

